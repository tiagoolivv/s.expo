{
  "name": "s-expo",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.12.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TiagoOlivv/s-expo.git"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "prebuild": "pnpm expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "xcode": "xed -b ios",
    "doctor": "npx expo-doctor@latest",
    "env:use": "node scripts/use-env.js",
    "rename": "node scripts/rename-app.js",
    "preinstall": "npx only-allow pnpm",
    "start:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run start",
    "prebuild:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "prebuild:development": "cross-env EXPO_PUBLIC_APP_ENV=development STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "android:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run android",
    "ios:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run ios",
    "start:production": "cross-env EXPO_PUBLIC_APP_ENV=production pnpm run start",
    "prebuild:production": "cross-env EXPO_PUBLIC_APP_ENV=production STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "android:production": "cross-env EXPO_PUBLIC_APP_ENV=production pnpm run android",
    "ios:production": "cross-env EXPO_PUBLIC_APP_ENV=production pnpm run ios",
    "build:development:ios": "eas build --profile development --platform ios",
    "build:development:android": "eas build --profile development --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:production:ios": "eas build --profile production --platform ios",
    "build:production:android": "eas build --profile production --platform android",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noemit",
    "lint:translations": "eslint ./src/translations/ --fix --ext .json",
    "test": "jest",
    "check-all": "pnpm run lint && pnpm run type-check && pnpm run lint:translations && pnpm run test && pnpm run test:hooks",
    "test:ci": "pnpm run test --coverage",
    "test:watch": "pnpm run test --watch",
    "test:hooks": "node --test \".agents/hooks/*.test.mjs\"",
    "coverage": "jest --coverage --coverageReporters=lcov --coverageReporters=json-summary",
    "quality": "pnpm run quality:crap && pnpm run quality:dry",
    "quality:crap": "sh scripts/quality.sh crap src",
    "quality:dry": "sh scripts/quality.sh dry src",
    "quality:mutate": "sh scripts/quality.sh mutate",
    "harness:score": "npx --yes harness-score@1.10.0 .",
    "install-maestro": "curl -Ls 'https://get.maestro.mobile.dev' | bash",
    "e2e-test": "maestro test .maestro/"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "^58.0.17",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-form": "^1.27.7",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/zod-form-adapter": "^0.42.1",
    "app-icon-badge": "^0.1.2",
    "axios": "^1.21.1",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "^58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-system-ui": "~58.0.7",
    "i18next": "^25.8.0",
    "lodash.memoize": "^4.1.2",
    "moti": "^0.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.0",
    "react-i18next": "^16.5.3",
    "react-native": "0.88.1",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "^1.22.7",
    "react-native-mmkv": "~4.3.2",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-reanimated": "~4.7.1",
    "react-native-restart": "0.0.27",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "~15.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "^0.13.0",
    "react-query-kit": "^3.3.2",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "uniwind": "^1.13.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@dev-plugins/react-query": "^0.4.0",
    "@eslint-react/eslint-plugin": "^2.7.2",
    "@expo/config": "~58.0.12",
    "@tailwindcss/cli": "^4.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/i18n-js": "^4.0.1",
    "@types/invariant": "^2.2.37",
    "@types/jest": "^30.0.0",
    "@types/lodash.memoize": "^4.1.9",
    "@types/node": "^25.0.9",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-better-tailwindcss": "^4.0.1",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-testing-library": "^7.15.4",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "jest-junit": "^16.0.0",
    "lint-staged": "^16.2.7",
    "tailwindcss": "4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-edge-to-edge",
          "react-native-restart"
        ]
      }
    }
  },
  "osMetadata": {
    "initVersion": "9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@humanfs/node@>=0.16.0 <0.16.8": "0.16.8",
      "@tootallnate/once@>=2.0.0 <2.0.1": "2.0.1",
      "@xmldom/xmldom@>=0.8.0 <0.8.15": "0.8.15",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.37",
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.22",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.8",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.13",
      "browserslist@>=4.0.0 <4.28.7": "4.29.6",
      "compression@>=1.0.0 <1.8.2": "1.8.2",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "flatted@>=3.0.0 <3.4.2": "3.4.4",
      "follow-redirects@>=1.0.0 <1.16.0": "1.16.3",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "lodash@>=4.0.0 <4.18.0": "4.18.1",
      "minimatch@>=3.0.0 <3.1.4": "3.1.5",
      "minimatch@>=8.0.0 <8.0.6": "8.0.7",
      "minimatch@>=9.0.0 <9.0.7": "9.0.9",
      "node-forge@>=1.0.0 <1.4.3": "1.4.3",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.7",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "7.2.1",
      "shell-quote@>=1.0.0 <1.9.0": "1.12.0",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "ws@>=7.0.0 <7.5.11": "7.5.14",
      "ws@>=8.0.0 <8.21.0": "8.23.0",
      "yaml@>=2.0.0 <2.8.3": "2.9.1"
    }
  }
}
